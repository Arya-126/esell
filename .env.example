# Copy to .env and fill in. All values are optional except in production.

# --- Core ---
PORT=3000
# REQUIRED in production: a long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL of the deployment (used in email links).
APP_URL=http://localhost:3000

# --- Payments (Stripe). Leave blank to use the built-in demo card stub. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Multi-currency / exchange rates (all optional) ---
# Rates refresh automatically from open.er-api.com (free, no key needed).
# Set a key to use exchangerate-api.com v6 instead:
EXCHANGE_RATE_API_KEY=
# Or point at any API returning { rates: { EUR: ..., GBP: ... } } per 1 USD:
EXCHANGE_RATE_API_URL=
# How often to refresh live rates (minutes, default 60):
FX_REFRESH_MINUTES=60

# --- Email ---
# Production SMTP (e.g. SendGrid, Mailgun, Postmark, Gmail app password):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ReWear <no-reply@rewear.dev>
# Or, with no SMTP set, use a real Ethereal test inbox (prints preview links):
MAIL_TEST=false
