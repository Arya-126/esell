# Self-hosted LLM inference server config.

# HuggingFace model id.
MODEL_NAME=google/flan-t5-base
# "text2text" for T5/Flan models, "causal" for Llama/Qwen/Phi instruct models.
MODEL_TYPE=text2text
# Generation limits.
MAX_NEW_TOKENS=256
TEMPERATURE=0.3

# Lighter (lower RAM, lower quality):   MODEL_NAME=google/flan-t5-small
# Better answers (needs ~6-8GB RAM, slower on CPU):
#   MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
#   MODEL_TYPE=causal
