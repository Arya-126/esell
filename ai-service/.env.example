# Copy to .env and fill in. The service runs with NO keys at all using the
# heuristic LLM + local fastembed + in-memory Qdrant (great for a quick demo),
# but for the real agentic experience set the Gemini + Qdrant Cloud values.

# --- LLM provider: auto | custom | gemini | heuristic ---
# auto = custom (if CUSTOM_LLM_URL set) > gemini (if GOOGLE_API_KEY) > heuristic.
LLM_PROVIDER=auto
# Your self-hosted model server (llm-api/). Set this to use your own LLM.
CUSTOM_LLM_URL=
# Use the custom model only for the final answer (route/grade via heuristic) —
# ~1 model call per turn; snappier and more reliable with small models.
CUSTOM_LLM_GENERATE_ONLY=false

# --- LLM: Google Gemini (free tier). Leave blank to use the heuristic fallback. ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- Embeddings: "fastembed" (local, no key, offline) or "gemini" (text-embedding-004) ---
EMBEDDINGS_PROVIDER=fastembed
GEMINI_EMBED_MODEL=models/text-embedding-004
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Qdrant. Priority: cloud URL > on-disk path > in-memory. ---
QDRANT_URL=
QDRANT_API_KEY=
# Keyless local demo: set a path so the indexer + service share an index on disk
# (open them one at a time). Leave blank for in-memory (per-process).
QDRANT_PATH=

PRODUCTS_COLLECTION=rewear_products
FAQ_COLLECTION=rewear_faq

# --- ReWear host app callback ---
REWEAR_API_URL=http://localhost:3000
# MUST match the Node app's JWT_SECRET so forwarded tokens can be verified.
JWT_SECRET=rewear-dev-secret-change-me
# Index the catalog on startup if Qdrant is empty (waits for ReWear, retries).
# Lets a fresh deploy self-index with no manual indexer run.
AUTO_INDEX=false

# --- Retrieval / Self-RAG tuning ---
TOP_K=5
MAX_REWRITES=2
